<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened Runtime entitlements。Electron 官方模板的基础项 + PyInstaller 打包的
  Python 解释器需要的两项（libpython.dylib 与其扩展模块在运行时做动态代码生成/
  加载未经我们签名的库，Hardened Runtime 默认会拦）：
    - com.apple.security.cs.allow-jit：CPython 的部分 C 扩展（如 ctypes）在运行时
      分配可执行内存。
    - com.apple.security.cs.disable-library-validation：PyInstaller bundle 里的
      .dylib/.so（libpython、_ssl 等）不是用我们的 Team ID 签的，禁用库校验后才能加载；
      正式发布前应逐个用同一 Team ID 重签这些库，然后去掉这条以收紧安全面。
    - com.apple.security.cs.allow-unsigned-executable-memory：CPython 解释器本身
      需要写可执行内存段（bootloader unpacking 阶段）。
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.automation.apple-events</key>
    <false/>
</dict>
</plist>
