# Jones 项目级运行数据（见 PRD 10.2）：记忆与运行态不提交，配置类可提交
.jones/memory/
.jones/runtime/
.jones/cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# Node / Electron
node_modules/
out/
# Anchored to repo root (was bare `release/`, W6/#25: that unanchored form
# matches a directory named `release` ANYWHERE in the tree, which swallowed
# the real, tracked `packaging/release/` and `scripts/release/` directories
# 05-w6-interfaces.md §1 explicitly assigns to Q/#25 — `git status`/`git add`
# silently saw neither. This repo has no top-level `release/` output dir
# today (electron-builder's own output goes to `build/release/dist`, already
# covered by the `build/` rule above), so anchoring changes nothing else.
/release/
.vite/

# 环境与凭据
.env
.env.*
*.pem
*.key

# 系统 / 编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# packaging spike (Issue #2)：下载/构建产物不入库
packaging/standalone/pyroot/
packaging/legacy/pyinstaller/.venv/
packaging/legacy/pyinstaller/build/
packaging/legacy/pyinstaller/dist/
packaging/standalone/dist/
packaging/electron-shell/dist/
packaging/legacy/pyinstaller/*.spec
